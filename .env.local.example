# LOCAL DEVELOPMENT ONLY. Copy to the ignored .env.local file; never commit it.
# HTTPS is required for preview/production. A local/LAN HTTP API is accepted only
# while running the development bundle, for example http://192.168.x.x:8080/api.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_WEB_BASE_URL=

EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
