{
  "expo": {
    "name": "Starry Nights",
    "slug": "starry-nights-mobile",
    "version": "1.0.0",
    "icon": "./assets/icon/owner-android-adaptive-foreground.png",
    "orientation": "portrait",
    "scheme": "starrynights",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.starrynightsindia.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.starrynightsindia.app",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/owner-android-adaptive-foreground.png",
        "backgroundColor": "#050505"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "dark": {
            "backgroundColor": "#000000"
          },
          "android": {
            "drawable": {
              "icon": "./assets/splash/transparent.xml",
              "darkIcon": "./assets/splash/transparent.xml"
            }
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Starry Nights to select travel photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bb8c3025-ba56-4234-af08-50b8f72eee44"
      }
    },
    "owner": "starrynightss-team"
  }
}
