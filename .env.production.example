# PRODUCTION / EAS PRODUCTION. Configure equivalent values in EAS instead of
# committing a local file. This approved public URL must retain the /api suffix.
EXPO_PUBLIC_API_BASE_URL=https://api.starrynightsindia.in/api
EXPO_PUBLIC_WEB_BASE_URL=https://starrynightsindia.in

# Enable only after the corresponding production OAuth audiences are registered
# with Google and allowlisted by the Node API.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
