# Include the /api path. This value is intentionally public and safe for Expo builds.
EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api
EXPO_PUBLIC_WEB_BASE_URL=https://example.com

# OAuth client IDs are public identifiers, not secrets. When Google auth is enabled,
# the Node API GOOGLE_ALLOWED_CLIENT_IDS allowlist must include each configured audience.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
