# STAGING / EAS PREVIEW. Copy only to an ignored local file for a local preview,
# or configure these values in the EAS "preview" environment. These values are
# public build configuration, not credentials.
EXPO_PUBLIC_API_BASE_URL=https://node-api-starrynightsindia-in.vercel.app/api
EXPO_PUBLIC_WEB_BASE_URL=https://node-starrynightsindia-in.vercel.app

# Keep disabled until registered staging Android/iOS client IDs are available.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
